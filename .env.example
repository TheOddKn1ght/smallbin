# Public browser-facing URL, without a trailing slash. HTTPS is required in production.
PUBLIC_ORIGIN=https://bin.example.com

# Host-only published port; nginx proxies to 127.0.0.1:3210 by default.
PORT=3210
SMALLBIN_IMAGE=smallbin:local

# Set the exact Docker network gateway IP after creating the Compose network.
# Never use 0.0.0.0/0 or trust arbitrary incoming forwarding headers.
TRUSTED_PROXIES=

# SQLite, WAL/SHM files, encrypted blobs, and pending uploads share this directory.
# Compose intentionally overrides this to /data inside its persistent volume.
DATA_DIR=./data
MAX_STORAGE_BYTES=10000000000
UPLOAD_TIMEOUT_MS=120000
DOWNLOAD_TIMEOUT_MS=120000
